# Dockerfile for building Windows Tauri app
FROM rust:1.75-bookworm

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    build-essential \
    libgtk-3-dev \
    libwebkit2gtk-4.0-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    nsis \
    # Windows cross-compilation dependencies
    mingw-w64 \
    llvm \
    lld \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Install Rust Windows targets
RUN rustup target add x86_64-pc-windows-gnu
RUN rustup target add x86_64-pc-windows-msvc || true

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Build command
CMD cd src-tauri && cargo tauri build --target x86_64-pc-windows-gnu